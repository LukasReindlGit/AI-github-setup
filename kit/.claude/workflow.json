  "integration_branch": "{{INTEGRATION}}",
  "branch_prefix": "{{PREFIX}}",
  "protected_branches": ["main", "master", "develop"],
  "allow_push": false,
  "check_command": "{{CHECK}}",
  "project_description": "",
  "format": {},
